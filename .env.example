# ==============================================================================
# doctree 런타임 환경 변수 설정 템플릿 (.env.example)
# 실제 사용 시 이 파일을 `.env`로 복사하여 값을 채워 넣으세요 (cp .env.example .env)
# ==============================================================================

# 1. Google Drive API v3 인증 및 조회 범위 (경계 ② 외부 네트워크 소켓 & ③ 파일시스템)
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json
GOOGLE_DRIVE_FOLDER_ID=

# 2. 외부 위협 인텔리전스 API 키 (경계 ② 외부 네트워크 소켓 - 선택 사항)
VIRUSTOTAL_API_KEY=

# 3. 로컬 파일시스템 경로 재정의 (경계 ③ 로컬 파일시스템 - 생략 시 기본 경로 사용)
# DOCTREE_SNAPSHOTS_DIR=snapshots
# DOCTREE_CATEGORY_TREE_FILE=config/category_tree.yaml
# DOCTREE_CONTENT_CATEGORY_MAP_FILE=config/content_category_map.yaml
# DOCTREE_PROJECT_LAYOUT_PROFILES_FILE=config/project_layout_profiles.yaml
# DOCTREE_VT_CACHE_FILE=snapshots/.vt_cache.json
# DOCTREE_LOCAL_CONTENTS_CACHE_FILE=snapshots/.local_contents_cache.json
# FREERIDE_WORKSPACE_DIR=..
